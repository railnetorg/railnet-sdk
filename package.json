{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "biome check --fix --unsafe",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vitest",
    "docs:dev": "vocs dev",
    "docs:build": "vocs build",
    "docs:preview": "vocs preview",
    "abis:check": "bun scripts/check-abis.ts",
    "abis:sync": "bun scripts/sync-abis.ts && bunx biome check --write src/abi/"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "latest",
    "@tanstack/react-query": "^5.95.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "react": "^19.2.4",
    "typescript": "latest",
    "vitest": "latest",
    "vocs": "^1.4.1",
    "wagmi": "^3.6.0",
    "zile": "^0.0.24"
  },
  "packageManager": "bun@1.3.10",
  "[!start-pkg]": "",
  "name": "railnet-sdk",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "skills",
    "!skills/_artifacts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "src": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "src": "./src/react/index.ts",
      "default": "./dist/react/index.js"
    }
  },
  "peerDependencies": {
    "viem": ">=2.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "wagmi": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
