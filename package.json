{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "format": "biome check --fix --unsafe",
    "lint": "tsgo && tsgo -p test/tsconfig.json",
    "dev": "zile dev",
    "test": "bun test --env-file .env.test --timeout 60000",
    "docs:dev": "vocs dev",
    "docs:build": "vocs build",
    "docs:preview": "vocs preview",
    "abis:check": "bun scripts/check-abis.ts",
    "abis:sync": "bun scripts/sync-abis.ts && bunx biome check --write src/abi/"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "latest",
    "@tanstack/react-query": "^5.95.2",
    "@types/bun": "^1.3.11",
    "@types/node": "latest",
    "@types/react": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260401.1",
    "react": "^19.2.4",
    "typescript": "latest",
    "vocs": "^1.4.1",
    "wagmi": "^3.6.0",
    "zile": "^0.0.24"
  },
  "packageManager": "bun@1.3.10",
  "[!start-pkg]": "",
  "name": "@railnetorg/railnet-sdk",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/railnetorg/railnet-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "!skills/_artifacts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "peerDependencies": {
    "viem": ">=2.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "wagmi": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  }
}
